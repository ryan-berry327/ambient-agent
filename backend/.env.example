CURSOR_API_KEY=your_cursor_key_here

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Default to replay mode in dev (set to false for live audio)
REPLAY_MIC_WAV=../samples/mic.wav
REPLAY_SYSTEM_WAV=../samples/system.wav

# Distiller (Cursor SDK)
DISTILL_MIN_INTERVAL_SEC=10
DISTILL_FORCE_INTERVAL_SEC=45
CURSOR_MODEL=composer-2.5
AUTO_BRIEF_AFTER_DISTILL=true

# Local transcription (free — faster-whisper)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
TRANSCRIPTION_BACKEND=whisper

# Phase B: optional GitHub push after successful smoke test
GITHUB_TOKEN=
GITHUB_REPO=
